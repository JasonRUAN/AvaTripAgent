PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# ---- LLM（任意 OpenAI 兼容接口；留空则自动走离线兜底行程） ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_TEMPERATURE=0.2
# 逐日展开的并发路数
SYNTH_DAY_CONCURRENCY=4

# ---- Avalanche Fuji ----
FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# 各 Agent 私钥（仅后端使用，绝不进入前端；.gitignore 需忽略 .env）
ORCHESTRATOR_KEY=
FLIGHT_AGENT_KEY=
HOTEL_AGENT_KEY=
ATTRACTION_AGENT_KEY=
DINING_AGENT_KEY=

# tokenURI 的公网基址（合约 setBaseURI 用，形如 https://xxx.ngrok.app/api/vouchers/）
PUBLIC_BASE_URL=http://localhost:3001
